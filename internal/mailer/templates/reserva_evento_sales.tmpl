{{define "subject"}}
Novo pedido de Reserva de Evento — {{.TipoEvento}}
{{end}}

{{define "body"}}

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 0;
        color: #323130;
      }

      .container {
        max-width: 700px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid #e1dfdd;
      }

      .header {
        background: #d83b01;
        padding: 20px;
        text-align: center;
        color: #ffffff;
        font-size: 18px;
        font-weight: bold;
      }

      .content {
        padding: 30px;
      }

      h2 {
        color: #d83b01;
        margin-bottom: 20px;
        font-weight: 600;
      }

      .details {
        background: #f8f8f8;
        border: 1px solid #e1dfdd;
        border-radius: 6px;
        padding: 15px;
        margin: 25px 0;
      }

      .details p {
        margin: 8px 0;
      }

      .highlight {
        background: #fff4e5;
        padding: 10px;
        border-left: 4px solid #d83b01;
        margin: 20px 0;
      }

      .footer {
        text-align: center;
        padding: 20px;
        font-size: 12px;
        color: #605e5c;
        background: #f3f2f1;
      }

      .btn {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        margin: 5px;
      }

      .confirm {
        background: #107c10;
        color: #fff;
      }

      .cancel {
        background: #d13438;
        color: #fff;
      }
    </style>
  </head>

  <body>
    <div class="container">

      <div class="header">
        NOVO LEAD — RESERVA DE EVENTO
      </div>

      <div class="content">

        <h2>Informação do Lead</h2>

        <div class="highlight">
          <p><b>Tipo de Evento:</b> {{.TipoEvento}}</p>
          <p><b>Tipo de Interesse:</b> {{.TipoInteresse}}</p>
          <p><b>Participantes:</b> {{.Participantes}}</p>
          <p><b>Data da Solicitação:</b> {{ .CriadoEm.Format "02/01/2006 15:04" }}</p>
        </div>

        <h2>Dados do Cliente</h2>

        <div class="details">
          <p><b>Nome:</b> {{.Nome}}</p>
          <p><b>Email:</b> {{.Email}}</p>
          <p><b>Contacto:</b> {{.Telefone}}</p>
          <p><b>Empresa:</b> {{.Empresa}}</p>
        </div>

        <h2>Coffee Break</h2>

        <div class="details">
          <p>
            <b>Incluído:</b>
            {{if .CoffeeBreak.Incluido}}Sim{{else}}Não{{end}}
          </p>

          <p><b>Tipo:</b> {{.CoffeeBreak.Tipo}}</p>
          <p><b>Pessoas:</b> {{.CoffeeBreak.Pessoas}}</p>
        </div>

        <h2>Datas Sugeridas pelo Cliente</h2>

        <div class="details">

          {{if .Datas}}

            <ul>
              {{range .Datas}}
                <li>{{.}}</li>
              {{end}}
            </ul>

          {{else}}

            <p>Nenhuma data informada.</p>

          {{end}}

        </div>

        <h2>Observações</h2>

        <div class="details">
          <p><b>Necessidades Específicas:</b><br />{{.Necessidades}}</p>
          <p><b>Mensagem:</b><br />{{.Mensagem}}</p>
        </div>

        <div class="highlight">
          <strong>Atenção:</strong><br>
          As datas acima são apenas sugestões do cliente. A confirmação final deve ser feita pela equipa.
        </div>

        <div style="margin-top:30px;text-align:center;">

          <a href="{{.ConfirmURL}}" class="btn confirm">
            ✅ Confirmar Reserva
          </a>

          <a href="{{.CancelURL}}" class="btn cancel">
            ❌ Cancelar Reserva
          </a>

        </div>

      </div>

      <div class="footer">
        © Onda Branca — Sistema de Reservas
      </div>

    </div>
  </body>
</html>

{{end}}