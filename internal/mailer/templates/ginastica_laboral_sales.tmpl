{{define "subject"}} Novo pedido — Ginástica Laboral {{end}}

{{define "body"}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 0;
        color: #323130;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid #e1dfdd;
      }
      .header {
        background: #006699;
        padding: 20px;
        text-align: center;
        color: #ffffff;
        font-size: 18px;
        font-weight: bold;
      }
      .content {
        padding: 30px;
      }
      h2 {
        color: #006699;
        margin-bottom: 20px;
      }
      .details {
        background: #f8f8f8;
        border: 1px solid #e1dfdd;
        border-radius: 6px;
        padding: 15px;
        margin: 25px 0;
      }
      .details p {
        margin: 8px 0;
      }
      .footer {
        text-align: center;
        padding: 20px;
        font-size: 12px;
        color: #605e5c;
        background: #f3f2f1;
      }
    </style>
  </head>

  <body>
    <div class="container">

      <div class="header">
        🏋️ Novo Pedido de Ginástica Laboral
      </div>

      <div class="content">

        <h2>Detalhes da Empresa</h2>

        <div class="details">
          <p><b>Nome:</b> {{.Name}}</p>
          <p><b>Email:</b> {{.Email}}</p>
          <p><b>Telefone:</b> {{.Telefone}}</p>
          <p><b>Empresa:</b> {{.Empresa}}</p>
          <p><b>Nº Funcionários:</b> {{.NumeroFuncionarios}}</p>
          <p><b>Área:</b> {{.Area}}</p>
          <p><b>Atividade Preferida:</b> {{.AtividadePreferida}}</p>
          <p><b>Objetivos:</b> {{.Objetivos}}</p>
          <p><b>Frequência:</b> {{.Frequencia}}</p>
          <p><b>Mensagem:</b> {{if .Mensagem}}{{.Mensagem}}{{else}}Sem mensagem adicional{{end}}</p>
          <p><b>Data/Hora:</b> {{.Data}}</p>
        </div>

        <p>
          Este pedido de Ginástica Laboral foi submetido através do formulário. Entrar em contacto com a empresa o mais rapidamente possível.
        </p>

      </div>

      <div class="footer">
        &copy; {{.Data}} Onda Branca — Notificação Interna
      </div>

    </div>
  </body>
</html>
{{end}}