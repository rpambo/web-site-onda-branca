{{define "subject"}} Novo pedido — Projeto de Qualidade de Vida {{end}}

{{define "body"}}

<!DOCTYPE html>

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 0;
        color: #323130;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid #e1dfdd;
      }
      .header {
        background: #006699;
        padding: 20px;
        text-align: center;
        color: #ffffff;
        font-size: 18px;
        font-weight: bold;
      }
      .content {
        padding: 30px;
      }
      h2 {
        color: #006699;
        margin-bottom: 20px;
        font-weight: 600;
      }
      .details {
        background: #f8f8f8;
        border: 1px solid #e1dfdd;
        border-radius: 6px;
        padding: 15px;
        margin: 25px 0;
      }
      .details p {
        margin: 8px 0;
      }
      .footer {
        text-align: center;
        padding: 20px;
        font-size: 12px;
        color: #605e5c;
        background: #f3f2f1;
      }
    </style>
  </head>
  <body>
    <div class="container">

```
  <!-- Cabeçalho -->
  <div class="header">
    🌱 Nova Inscrição — Projeto de Qualidade de Vida
  </div>

  <!-- Conteúdo -->
  <div class="content">
    <h2>Detalhes do Participante</h2>

    <div class="details">
      <p><b>Nome:</b> {{.Name}}</p>
      <p><b>Email:</b> {{.Email}}</p>
      <p><b>Contacto:</b> {{.Contact}}</p>
      <p><b>Idade:</b> {{if .Age}}{{.Age}}{{else}}Não informada{{end}}</p>
      <p><b>Áreas de Interesse:</b> {{.AreasInterest}}</p>
      <p><b>Objetivo Principal:</b> {{.PersonalGoal}}</p>
      <p><b>Frequência Preferida:</b> {{.Frequencia}}</p>
      <p><b>Experiência Prévia:</b> {{.ExperiencePrior}}</p>
      <p><b>Mensagem:</b> {{.Message}}</p>
      <p><b>Data/Hora:</b> {{.Data}}</p>
    </div>

    <p>
      Este participante demonstrou interesse no Projeto de Qualidade de Vida.
      Por favor, entre em contacto para dar seguimento ao processo.
    </p>
  </div>

  <!-- Rodapé -->
  <div class="footer">
    &copy; {{.Data}} Onda Branca — Notificação Interna
  </div>

</div>
```

  </body>
</html>
{{end}}